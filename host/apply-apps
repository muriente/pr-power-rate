#!/usr/bin/env python3
"""apply-apps — type the rate in force into the phone apps that have no rate URL, and verify it on screen.

Usage: apply-apps [--if-changed CURRENT_JSON] [--force] [--only APP] [--dry-run]
  --if-changed  read the price from this current.json (default: the live endpoint) and act only for apps whose
                last applied price differs (state: ~/Library/Application Support/pr-power-rate/applied.json)
  --force       re-apply even when the state says it is current
Each app is applied independently; one failing app does not stop the others. A busy phone (Hotplug lease) is a
skip, retried on the next hourly run. Exit: 0 all done/skipped-current · 1 some app failed · 75 phone busy.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
import traceback
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from android import Busy, Device  # noqa: E402
import apps  # noqa: E402

STATE_DIR = Path.home() / "Library/Application Support/pr-power-rate"
STATE = STATE_DIR / "applied.json"
LOG = STATE_DIR / "logs/apply-apps.log"
LIVE = "https://muriente.github.io/pr-power-rate/api/v1/current.json"


def log(msg: str) -> None:
    line = f"{dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {msg}"
    print(line)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as fh:
        fh.write(line + "\n")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--if-changed")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--only")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    if a.if_changed:
        cur = json.loads(Path(a.if_changed).read_text())
    else:
        with urllib.request.urlopen(LIVE, timeout=30) as r:
            cur = json.load(r)
    if cur.get("verification", {}).get("status") != "verified":
        log("price not verified; nothing applied")
        return 1
    price = cur["price_usd_per_kwh"]
    state = json.loads(STATE.read_text()) if STATE.exists() else {}

    todo = [name for name in apps.APPS if (not a.only or name == a.only)
            and (a.force or state.get(name, {}).get("price_usd_per_kwh") != price)]
    if not todo:
        return 0
    log(f"apply {price} USD/kWh ({cur['period_label']}) to {todo}")
    if a.dry_run:
        return 0

    failed = busy = False
    for name in todo:
        spec = apps.APPS[name]
        dev = Device(spec["route"], spec.get("serial", "66160DLKX004F1"))
        try:
            dev.acquire_lease()
            try:
                shown = spec["apply"](dev, price, STATE_DIR / "evidence")
            finally:
                dev.key("KEYCODE_HOME")
                dev.release_lease()
            state[name] = {"price_usd_per_kwh": price, "shown": shown, "period": cur["period_label"],
                           "applied_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")}
            STATE.write_text(json.dumps(state, indent=2) + "\n")
            log(f"{name}: applied and read back {shown!r}")
        except Busy as exc:
            busy = True
            log(f"{name}: skipped, {exc}")
        except Exception as exc:  # report and continue with the next app
            failed = True
            log(f"{name}: FAILED {type(exc).__name__}: {exc}\n{traceback.format_exc()}")
    return 1 if failed else (75 if busy else 0)


if __name__ == "__main__":
    sys.exit(main())
